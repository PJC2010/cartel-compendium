<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <rect width="800" height="600" fill="#d4852a"/>
  <rect x="0" y="0" width="800" height="600" fill="url(#stripes)" opacity="0.1"/>
  <defs>
    <pattern id="stripes" width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="20" height="40" fill="#ffffff"/>
      <rect x="20" width="20" height="40" fill="#000000"/>
    </pattern>
  </defs>
  <text x="400" y="300" text-anchor="middle" dy=".35em" font-family="Inter,sans-serif" font-size="36" font-weight="700" fill="#e8e8ed" opacity="0.8">CJNG</text>
</svg>