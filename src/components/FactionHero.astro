---
import type { Faction } from '../lib/schemas';

export interface Props {
  faction: Faction;
}
const { faction } = Astro.props;
---

<div class="relative bg-bg-secondary border-b border-border overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-accent/5 to-transparent" />
  <div class="relative max-w-6xl mx-auto px-4 py-10 sm:py-14">
    <h1 class="font-display font-bold text-2xl sm:text-3xl text-text-primary mb-1">
      {faction.name}
    </h1>
    <p class="text-sm text-text-secondary mb-3">
      Leader: <span class="text-text-primary">{faction.leader}</span>
    </p>
    <p class="text-sm text-text-secondary max-w-2xl leading-relaxed">
      {faction.description}
    </p>
  </div>
</div>