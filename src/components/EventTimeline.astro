---
export interface Props {
  events: { date: string; event: string }[];
}
const { events } = Astro.props;
const sorted = [...events].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<div class="space-y-2">
  <h2 class="font-display font-semibold text-lg text-text-primary">Major Events</h2>
  {sorted.length === 0 ? (
    <p class="text-sm text-text-muted italic">No events recorded.</p>
  ) : (
    <div class="relative pl-6 border-l-2 border-border space-y-5">
      {sorted.map((evt) => {
        const d = new Date(evt.date + 'T00:00:00');
        const formatted = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        return (
          <div class="relative">
            <div class="absolute -left-[25px] top-1.5 w-3 h-3 rounded-full bg-accent border-2 border-bg-primary" />
            <time class="block text-xs text-text-muted mb-0.5">{formatted}</time>
            <p class="text-sm text-text-secondary leading-relaxed">{evt.event}</p>
          </div>
        );
      })}
    </div>
  )}
</div>