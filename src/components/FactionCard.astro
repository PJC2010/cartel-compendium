---
import type { Faction } from '../lib/schemas';

export interface Props {
  faction: Faction;
}
const { faction } = Astro.props;
---

<a
  href={`/faction/${faction.id}`}
  class="group block bg-bg-card border border-border rounded-lg p-5
         hover:bg-bg-card-hover hover:border-text-muted/30 transition-all duration-200
         focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
>
  <h3 class="font-display font-semibold text-lg text-text-primary group-hover:text-accent-hover transition-colors mb-2">
    {faction.name}
  </h3>
  {faction.leader && (
    <p class="text-xs text-text-secondary mb-2">
      <span class="text-text-muted">Leader:</span> {faction.leader}
    </p>
  )}
  <p class="text-sm text-text-secondary leading-relaxed line-clamp-3 mb-3">
    {faction.description}
  </p>
  <div class="flex items-center gap-1.5 text-xs text-text-muted">
    <span>{faction.members.length} known member{faction.members.length !== 1 ? 's' : ''}</span>
  </div>
</a>