---
import Layout from '../../layouts/Layout.astro';
import FactionHero from '../../components/FactionHero.astro';
import FigureCard from '../../components/FigureCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getFactions, getFaction, getFiguresByFaction, getCartel } from '../../lib/data';

export function getStaticPaths() {
  return getFactions().map((f) => ({ params: { id: f.id } }));
}

const { id } = Astro.params;
const faction = getFaction(id as string);

if (!faction) {
  return Astro.redirect('/404');
}

const cartel = getCartel(faction.cartel_id);
const members = getFiguresByFaction(faction.id);
---

<Layout title={faction.name}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      ...(cartel ? [{ label: cartel.name, href: `/cartel/${cartel.id}` }] : []),
      { label: faction.name },
    ]}
  />
  <FactionHero faction={faction} />

  <section class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="font-display font-semibold text-xl text-text-primary mb-4">
      Members
    </h2>
    {members.length === 0 ? (
      <p class="text-sm text-text-muted italic">No members recorded for this faction.</p>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {members.map((figure) => (
          <FigureCard
            id={figure.id}
            name={figure.name}
            alias={figure.alias}
            role={figure.role}
            status={figure.status}
            image={figure.images[0]?.src}
          />
        ))}
      </div>
    )}
  </section>
</Layout>