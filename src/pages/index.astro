---
import Layout from '../layouts/Layout.astro';
import CartelCard from '../components/CartelCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getCartels } from '../lib/data';

const cartels = getCartels();
---

<Layout title="Home">
  <section class="max-w-6xl mx-auto px-4 py-8 sm:py-12">
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="font-display font-bold text-3xl sm:text-4xl text-text-primary mb-2">
            Mexican Drug Cartels
          </h1>
          <p class="text-sm text-text-secondary max-w-xl">
            A layered compendium of cartel organizations, their factions, and the figures who lead them.
          </p>
        </div>
        <div class="w-full sm:w-auto sm:min-w-[280px]">
          <SearchBar />
        </div>
      </div>
    </div>

    {cartels.length === 0 ? (
      <div class="bg-bg-card border border-border rounded-lg p-12 text-center">
        <p class="text-text-muted text-lg mb-2">No cartels yet</p>
        <p class="text-text-secondary text-sm">
          Add entries to <code class="text-xs bg-bg-secondary px-1.5 py-0.5 rounded border border-border">src/data/cartels.json</code> to populate the compendium.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {cartels.map((cartel) => (
          <CartelCard
            id={cartel.id}
            name={cartel.name}
            alias={cartel.alias}
            founded={cartel.founded}
            status={cartel.status}
            description={cartel.description}
            image={cartel.image}
          />
        ))}
      </div>
    )}
  </section>
</Layout>